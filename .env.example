# ---------- Core ----------
ENVIRONMENT=development
DEBUG=true

# ---------- Database (Postgres + pgvector) ----------
DATABASE_URL=postgresql+psycopg://eih:eih@localhost:5432/eih
# No Docker? Use SQLite for local dev instead:
# DATABASE_URL=sqlite+pysqlite:///./eih.db

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- LLM provider (any OpenAI-compatible endpoint) ----------
# For OpenAI:    LLM_BASE_URL=https://api.openai.com/v1
# For Gemini:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# For local dev without a key, set LLM_PROVIDER=mock
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# openai | local (sentence-transformers) | hash (deterministic dev fallback)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Used when EMBEDDING_PROVIDER=local (dims must match: all-MiniLM-L6-v2 = 384)
EMBEDDING_LOCAL_MODEL=all-MiniLM-L6-v2

# ---------- GitHub ----------
# Optional PAT for private repositories / higher rate limits
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Limits ----------
MAX_UPLOAD_MB=25
MAX_REPO_MB=200
RATE_LIMIT_PER_MINUTE=120
